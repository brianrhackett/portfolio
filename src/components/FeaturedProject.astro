---
interface Props {
	title: string;
	eyebrow: string;
	tagline: string;
	description: string;
	image: string;
	imageAlt: string;
	href: string;
	reverse?: boolean;
	number?: string;
}

const {
	title,
	eyebrow,
	tagline,
	description,
	image,
	imageAlt,
	href,
	reverse = false,
	number
} = Astro.props;
---

<article
	class:list={[
		'grid items-center gap-12 border-t border-taupe-300 py-20 lg:gap-16',
        reverse
            ? 'lg:grid-cols-[0.9fr_1.1fr]'
            : 'lg:grid-cols-[1.1fr_0.9fr]'
	]}
>
	<div class:list={[reverse ? 'lg:order-2' : 'lg:order-1']}>
		<div class="relative aspect-[4/3] overflow-hidden rounded-xl">
            <img
                src={image}
                alt={imageAlt}
                class="h-full w-full object-cover object-left"
            />

            {number && (
                <span
                    class="absolute bottom-4 right-6 font-serif text-8xl text-white/20"
                    aria-hidden="true"
                >
                    {number}
                </span>
            )}
        </div>
	</div>

	<div
		class:list={[
			'max-w-2xl',
			reverse ? 'lg:order-1' : 'lg:order-2'
		]}
	>
		<p class="mb-5 text-xs font-semibold uppercase tracking-[0.12em] text-orange-700">
			{eyebrow}
		</p>

		<h2 class="font-serif text-3xl leading-none tracking-tight text-mist-900 lg:text-5xl">
			{title}
		</h2>

		<p class="mt-7 font-serif text-xl italic leading-relaxed text-mist-500 lg:text-2xl">
			{tagline}
		</p>

		<p class="mt-7 text-base leading-7 text-mist-700">
			{description}
		</p>

		<a
			href={href}
			class="mt-9 inline-flex items-center gap-2 rounded-full border border-mist-800 px-7 py-3 text-sm font-semibold text-mist-900 transition hover:bg-mist-900 hover:text-taupe-100"
		>
			Read more
			<span aria-hidden="true">→</span>
		</a>
	</div>
</article>